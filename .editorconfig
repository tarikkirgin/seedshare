# EditorConfig helps maintain consistent coding styles between different editors and IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{js,ts,jsx,tsx,svelte}]
indent_size = 2

[*.json]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off
insert_final_newline = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{css,scss,less}]
indent_style = space
indent_size = 2
